# Copiaza acest fisier in ".env" si completeaza valorile. ".env" nu se urca pe GitHub.

# --- Telegram (obligatoriu pentru alerte) ---
TELEGRAM_BOT_TOKEN=
# Unul sau mai multe ID-uri separate prin virgula
TELEGRAM_CHAT_ID=

# --- Inspectie AI (optional) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# AI_MIN_CONFIDENCE_SCORE=75

# --- Praguri pont (un anunt e pont doar daca le indeplineste pe AMBELE) ---
MIN_NET_PROFIT_EUR=1200
MIN_DISCOUNT_PERCENT=15

# --- Costuri estimate scazute din profit ---
BUFFER_EXPENSES_EUR=1050
IMPORT_EXTRA_COST_EUR=850

# --- Filtre cautare ---
MIN_LISTING_PRICE_EUR=1800
MAX_LISTING_PRICE_EUR=15000
MAX_MILEAGE_KM=260000
MIN_YEAR=2005

# Curs folosit pentru anunturile in LEI (actualizeaza-l periodic)
EUR_RON_RATE=5.0

SCAN_INTERVAL_SECONDS=60
